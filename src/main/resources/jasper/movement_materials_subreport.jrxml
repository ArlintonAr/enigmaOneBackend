<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="movement_materials_subreport" pageWidth="555" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
    <field name="id" class="java.lang.Long"/>
    <field name="stockId" class="java.lang.Long"/>
    <field name="stockCode" class="java.lang.String"/>
    <field name="quantity" class="java.lang.Integer"/>
    <field name="destinationMaterial" class="java.lang.String"/>
    <field name="type" class="java.lang.String"/>

    <title>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="555" height="18"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Materiales del Movimiento]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="18">
            <staticText>
                <reportElement x="0" y="0" width="120" height="18"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Código Stock]]></text>
            </staticText>
            <staticText>
                <reportElement x="120" y="0" width="80" height="18"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Stock ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="200" y="0" width="120" height="18"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Cantidad]]></text>
            </staticText>
            <staticText>
                <reportElement x="320" y="0" width="235" height="18"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Destino / Observación]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="36">
            <textField>
                <reportElement x="0" y="0" width="120" height="18"/>
                <textFieldExpression><![CDATA[$F{stockCode}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="120" y="0" width="80" height="18"/>
                <textFieldExpression><![CDATA[$F{stockId}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="200" y="0" width="120" height="18"/>
                <textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="320" y="0" width="235" height="18"/>
                <textFieldExpression><![CDATA[$F{destinationMaterial}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="18" width="555" height="18"/>
                <textElement><font size="9" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Tipo: " + $F{type}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

</jasperReport>

